#: poll/public/handlebars/poll_results.handlebars:5
#: poll/public/handlebars/survey_results.handlebars:4
msgid "Results"
msgstr "შედეგები"

#: poll/public/handlebars/poll_results.handlebars:32
#: poll/public/handlebars/survey_results.handlebars:40
msgid "Results gathered from {total} respondent."
msgid_plural "Results gathered from {total} respondents."
msgstr[0] "შედეგები შეგროვდა {total} რესპონდენტისგან."

#: poll/public/handlebars/poll_results.handlebars:36
#: poll/public/handlebars/survey_results.handlebars:45
msgid "Feedback"
msgstr "უკუკავშირი"

#: poll/public/handlebars/poll_studio.handlebars:6
msgid "move poll up"
msgstr "გამოკითხვის გადატანა ზემოთ"

#: poll/public/handlebars/poll_studio.handlebars:7
msgid "move poll down"
msgstr "გამოკითხვის ქვემოთ გადატანა"

#: poll/public/handlebars/poll_studio.handlebars:9
msgid "Delete"
msgstr "წაშლა"

#: poll/public/handlebars/poll_studio.handlebars:11
msgid "Answer"
msgstr "პასუხი"

#: poll/public/handlebars/poll_studio.handlebars:12
msgid "Question"
msgstr "კითხვა"

#: poll/public/handlebars/poll_studio.handlebars:16
msgid "Image URL"
msgstr "გამოსახულების ბმული"

#: poll/public/handlebars/poll_studio.handlebars:18
msgid "Image alternative text"
msgstr "სურათის ალტერნატიული ტექსტი"

#: poll/public/handlebars/poll_studio.handlebars:23
msgid ""
"You can make limited use of Markdown in answer texts, preferably only bold "
"and italics."
msgstr ""
"თქვენ შეგიძლიათ შეზღუდული გამოიყენოთ Markdown პასუხის ტექსტებში, "
"სასურველია მხოლოდ თამამი და დახრილი."

#: poll/public/handlebars/poll_studio.handlebars:27
msgid ""
"This must have an image URL or text, and can have both.  If you add an "
"image, you must also provide an alternative text that describes the image "
"in a way that would allow someone to answer the poll if the image did not "
"load."
msgstr ""
"მას უნდა ჰქონდეს სურათის URL ან ტექსტი და შეიძლება ჰქონდეს ორივე.  თუ "
"სურათს დაამატებთ, ასევე უნდა მიაწოდოთ ალტერნატიული ტექსტი, რომელიც აღწერს "
"სურათს ისე, რომ ვინმეს საშუალება მისცეს უპასუხოს გამოკითხვას, თუ სურათი არ "
"ჩაიტვირთა."
